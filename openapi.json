          },
          "dataset_hours": {
            "type": "integer",
            "title": "Dataset Hours"
          },
          "artifacts_ready": {
            "type": "boolean",
            "title": "Artifacts Ready"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "dataset_hours",
          "artifacts_ready"
        ],
        "title": "HealthResponse"
      },
      "MarketTick": {
        "properties": {
          "repo_apy": {
            "type": "number",
            "title": "Repo Apy"
          },
          "bond_yield": {
            "type": "number",
            "title": "Bond Yield"
          },
          "bond_price": {
            "type": "number",
            "title": "Bond Price"
          },
          "equity_price": {
            "type": "number",
            "title": "Equity Price"
          },
          "equity_vol_realized": {
            "type": "number",
            "title": "Equity Vol Realized"
          },
          "hour": {
            "type": "integer",
            "title": "Hour"
          },
          "repo_window_open": {
            "type": "boolean",
            "title": "Repo Window Open"
          },
          "repo_mature": {
            "type": "boolean",
            "title": "Repo Mature"
          }
        },
        "type": "object",
        "required": [
          "repo_apy",
          "bond_yield",
          "bond_price",
          "equity_price",
          "equity_vol_realized",
          "hour",
          "repo_window_open",
          "repo_mature"
        ],
        "title": "MarketTick"
      },
      "StrategyBalances": {
        "properties": {
          "cash": {
            "type": "number",
            "title": "Cash"
          },
          "repo": {
            "type": "number",
            "title": "Repo"
          },
          "bond_mv": {
            "type": "number",
            "title": "Bond Mv"
          },
          "equity_mv": {
            "type": "number",
            "title": "Equity Mv"
          },
          "overdraft": {
            "type": "number",
            "title": "Overdraft"
          }
        },
        "type": "object",
        "required": [
          "cash",
          "repo",
          "bond_mv",
          "equity_mv",
          "overdraft"
        ],
        "title": "StrategyBalances"
      },
      "StrategyCumCosts": {
        "properties": {
          "repo_interest": {
            "type": "number",
            "title": "Repo Interest"
          },
          "bond_carry": {
            "type": "number",
            "title": "Bond Carry"
          },
          "capital_pnl": {
            "type": "number",
            "title": "Capital Pnl"
          },
          "haircuts": {
            "type": "number",
            "title": "Haircuts"
          },
          "od_interest": {
            "type": "number",
            "title": "Od Interest"
          }
        },
        "type": "object",
        "required": [
          "repo_interest",
          "bond_carry",
          "capital_pnl",
          "haircuts",
          "od_interest"
        ],
        "title": "StrategyCumCosts"
      },
      "StrategyTickState": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "overlays": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Overlays"
          },
          "balances": {
            "$ref": "#/components/schemas/StrategyBalances"
          },
          "nav": {
            "type": "number",
            "title": "Nav"
          },
          "econ_pnl": {
            "type": "number",
            "title": "Econ Pnl"
          },
          "drawdown": {
            "type": "number",
            "title": "Drawdown"
          },
          "cum": {
            "$ref": "#/components/schemas/StrategyCumCosts"
          },
          "action": {
            "additionalProperties": true,
            "type": "object",
            "title": "Action"
          },
          "forecast": {
            "additionalProperties": true,
            "type": "object",
            "title": "Forecast"
          },
          "gatekeeper": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gatekeeper"
          }
        },
        "type": "object",
        "required": [
          "state",
          "overlays",
          "balances",
          "nav",
          "econ_pnl",
          "drawdown",
          "cum",
          "action",
          "forecast"
        ],
        "title": "StrategyTickState"
      },
      "StreamRangeResponse": {
        "properties": {
          "stride": {
            "type": "integer",
            "title": "Stride"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "ticks": {
            "items": {
              "$ref": "#/components/schemas/StreamTickResponse"
            },
            "type": "array",
            "title": "Ticks"
          }
        },
        "type": "object",
        "required": [
          "stride",
          "count",
          "ticks"
        ],
        "title": "StreamRangeResponse"
      },
      "StreamTickResponse": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "market": {
            "$ref": "#/components/schemas/MarketTick"
          },
          "flows": {
            "$ref": "#/components/schemas/FlowTick"
          },
          "strategies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/StrategyTickState"
            },
            "type": "object",
            "title": "Strategies"
          }
        },
        "type": "object",
        "required": [
          "index",
          "timestamp",
          "market",
          "flows",
          "strategies"
        ],
        "title": "StreamTickResponse"
      },
      "StressShockRequest": {
        "properties": {
          "withdrawal_multiplier": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.5,
            "title": "Withdrawal Multiplier",
            "default": 1.0
          },
          "deposit_multiplier": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Deposit Multiplier",
            "default": 1.0
          },
          "window": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window"
          },
          "run_event": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Event"
          },
          "rate_shock_bps": {
            "type": "number",
            "maximum": 500.0,
            "minimum": -500.0,
            "title": "Rate Shock Bps",
            "default": 0.0
          },
          "rate_shock_ramp_hours": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rate Shock Ramp Hours",
            "default": 168
          },
          "rate_shock_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate Shock Start"
          },
          "equity_crash_pct": {
            "type": "number",
            "maximum": 0.0,
            "minimum": -60.0,
            "title": "Equity Crash Pct",
            "default": 0.0
          },
          "equity_crash_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Equity Crash Start"
          },
          "equity_crash_hours": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Equity Crash Hours",
            "default": 240
          }
        },
        "type": "object",
        "title": "StressShockRequest"
      },
      "StressSimulationRequest": {
        "properties": {
          "aum0": {
            "type": "number",
            "minimum": 100000000.0,
            "title": "Aum0",
            "default": 3000000000.0
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          },
          "strategies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strategies",
            "default": [
              "aegisflow",
              "baseline2_static"
