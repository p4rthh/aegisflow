            "title": "Aum0",
            "default": 3000000000.0
          },
          "risk_mode": {
            "type": "string",
            "title": "Risk Mode",
            "default": "cost_optimal"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          }
        },
        "type": "object",
        "title": "BacktestRunRequest"
      },
      "FlowTick": {
        "properties": {
          "deposits": {
            "type": "number",
            "title": "Deposits"
          },
          "withdrawals": {
            "type": "number",
            "title": "Withdrawals"
          },
          "net": {
            "type": "number",
            "title": "Net"
          }
        },
        "type": "object",
        "required": [
          "deposits",
          "withdrawals",
          "net"
        ],
        "title": "FlowTick"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
